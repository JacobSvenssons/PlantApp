<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
	Repo-lokal NuGet-konfiguration. <clear /> nollställer alla paketkällor som ärvs
	från maskin-/användarnivå (t.ex. privata företagsflöden) så att det här projektet
	ENDAST använder den publika nuget.org. Det gör återställning (restore) snabb och
	reproducerbar oavsett vilken dator som bygger projektet.
  -->
  <packageSources>
	<clear />
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
