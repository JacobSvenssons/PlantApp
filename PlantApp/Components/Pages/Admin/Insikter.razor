@page "/admin/insikter"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Globalization
@attribute [Authorize(Roles = "Admin")]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<PageTitle>Hyggligt – Insikter</PageTitle>

<div class="insikter-page">
    <div class="insikter-card card-soft">
        <div class="insikter-card__header">
            <div class="insikter-card__brand">
                <span class="insikter-card__logo" aria-hidden="true">📊</span>
                <div>
                    <h1 class="insikter-card__titel">Insikter</h1>
                    <p class="insikter-card__subtitel">Välj trakter och jämför nyckeltal för planteringen.</p>
                </div>
            </div>
            <a class="btn-pill btn-pill--ghost" href="/admin">Till admin</a>
        </div>

        @if (_loadError is not null)
        {
            <div class="insikter-melding insikter-melding--fel">@_loadError</div>
        }
        else if (_statistik is null)
        {
            <div class="insikter-melding">Laddar statistik…</div>
        }
        else if (_statistik.Count == 0)
        {
            <div class="insikter-melding">
                Inga trakter finns ännu. Lägg till en ny trakt på
                <a href="/admin/upload">adminsidan</a>.
            </div>
        }
        else
        {
            <div class="insikter-vaxel" role="tablist">
                <button type="button"
                        class="insikter-vaxel__knapp @(_vy == InsiktVy.Plantering ? "insikter-vaxel__knapp--aktiv" : "")"
                        role="tab"
                        aria-selected="@(_vy == InsiktVy.Plantering)"
                        @onclick="() => _vy = InsiktVy.Plantering">
                    🌱 Insikter – Plantering
                </button>
                <button type="button"
                        class="insikter-vaxel__knapp @(_vy == InsiktVy.Inventering ? "insikter-vaxel__knapp--aktiv" : "")"
                        role="tab"
                        aria-selected="@(_vy == InsiktVy.Inventering)"
                        @onclick="() => _vy = InsiktVy.Inventering">
                    🔬 Insikter – Inventering
                </button>
            </div>

            @if (_vy == InsiktVy.Plantering)
            {
            <div class="insikter-val">
                <div class="insikter-val__topp">
                    <span class="insikter-val__rubrik">Trakter (@_valda.Count / @_statistik.Count)</span>
                    <div class="insikter-val__knappar">
                        <button type="button" class="knapp-lank" @onclick="MarkeraAlla">Markera alla</button>
                        <button type="button" class="knapp-lank" @onclick="RensaVal">Rensa</button>
                    </div>
                </div>
                <div class="insikter-val__lista">
                    @foreach (var trakt in _statistik)
                    {
                        <label class="insikter-val__rad">
                            <input type="checkbox" checked="@_valda.Contains(trakt.TraktId)"
                                   @onchange="e => OnTraktToggle(trakt.TraktId, e)" />
                            <span class="insikter-val__namn">@trakt.Namn</span>
                            <span class="insikter-val__meta">@trakt.AntalDelomraden delområden</span>
                        </label>
                    }
                </div>
            </div>

            <div class="insikter-summering">
                <div class="stat-kort">
                    <span class="stat-kort__ikon" aria-hidden="true">🌱</span>
                    <div class="stat-kort__varde">@_summering.TotaltAntalPlantor.ToString("N0", CultureInfo.CurrentCulture)</div>
                    <div class="stat-kort__etikett">Satta plantor</div>
                </div>
                <div class="stat-kort">
                    <span class="stat-kort__ikon" aria-hidden="true">🎯</span>
                    <div class="stat-kort__varde">@_summering.MalTotaltAntalPlantor.ToString("N0", CultureInfo.CurrentCulture)</div>
                    <div class="stat-kort__etikett">Mål plantor</div>
                </div>
                <div class="stat-kort">
                    <span class="stat-kort__ikon" aria-hidden="true">📊</span>
                    <div class="stat-kort__varde">
                        @(_summering.MalTotaltAntalPlantor > 0
                            ? $"{_summering.ProcentAvMal.ToString("0.#", CultureInfo.CurrentCulture)} %"
                            : "–")
                    </div>
                    <div class="stat-kort__etikett">Måluppfyllelse</div>
                </div>
                <div class="stat-kort">
                    <span class="stat-kort__ikon" aria-hidden="true">✅</span>
                    <div class="stat-kort__varde">@_summering.AntalKlara / @_summering.AntalDelomraden</div>
                    <div class="stat-kort__etikett">Klara delområden</div>
                </div>
                <div class="stat-kort">
                    <span class="stat-kort__ikon" aria-hidden="true">📈</span>
                    <div class="stat-kort__varde">@_summering.ProcentKlar.ToString("0.#", CultureInfo.CurrentCulture) %</div>
                    <div class="stat-kort__etikett">Färdigplanterat</div>
                </div>
                <div class="stat-kort">
                    <span class="stat-kort__ikon" aria-hidden="true">📐</span>
                    <div class="stat-kort__varde">@_summering.TotalAreal.ToString("0.##", CultureInfo.CurrentCulture) ha</div>
                    <div class="stat-kort__etikett">Total areal</div>
                </div>
                <div class="stat-kort">
                    <span class="stat-kort__ikon" aria-hidden="true">🔬</span>
                    <div class="stat-kort__varde">@_summering.AntalProvytor.ToString("N0", CultureInfo.CurrentCulture)</div>
                    <div class="stat-kort__etikett">Provytor</div>
                </div>
                <div class="stat-kort">
                    <span class="stat-kort__ikon" aria-hidden="true">⚠️</span>
                    <div class="stat-kort__varde">@_summering.AntalAvvikelser.ToString("N0", CultureInfo.CurrentCulture)</div>
                    <div class="stat-kort__etikett">Avvikelser</div>
                </div>
            </div>

            <div class="insikter-tabell">
                <div class="insikter-tabell__rubrik">Per trakt</div>
                @if (_valda.Count == 0)
                {
                    <div class="insikter-melding">Välj en eller flera trakter ovan för att se detaljer.</div>
                }
                else
                {
                    <table class="tabell">
                        <thead>
                            <tr>
                                <th>Trakt</th>
                                <th class="tabell__num">Delområden</th>
                                <th class="tabell__num">Klara</th>
                                <th class="tabell__num">Färdigt</th>
                                <th class="tabell__num">Areal (ha)</th>
                                <th class="tabell__num">Plantor</th>
                                <th class="tabell__num">Mål</th>
                                <th class="tabell__num">Måluppfyllelse</th>
                                <th class="tabell__num">Provytor</th>
                                <th class="tabell__num">Karta</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trakt in _statistik.Where(t => _valda.Contains(t.TraktId)))
                            {
                                var maluppfyllelse = trakt.MalTotaltAntalPlantor > 0
                                    ? $"{(trakt.TotaltAntalPlantor / (double)trakt.MalTotaltAntalPlantor * 100d).ToString("0.#", CultureInfo.CurrentCulture)} %"
                                    : "–";
                                <tr>
                                    <td>@trakt.Namn</td>
                                    <td class="tabell__num">@trakt.AntalDelomraden</td>
                                    <td class="tabell__num">@trakt.AntalKlara</td>
                                    <td class="tabell__num">@trakt.ProcentKlar.ToString("0.#", CultureInfo.CurrentCulture) %</td>
                                    <td class="tabell__num">@trakt.TotalAreal.ToString("0.##", CultureInfo.CurrentCulture)</td>
                                    <td class="tabell__num">@trakt.TotaltAntalPlantor.ToString("N0", CultureInfo.CurrentCulture)</td>
                                    <td class="tabell__num">@trakt.MalTotaltAntalPlantor.ToString("N0", CultureInfo.CurrentCulture)</td>
                                    <td class="tabell__num">@maluppfyllelse</td>
                                    <td class="tabell__num">@trakt.AntalProvytor</td>
                                    <td class="tabell__num">
                                        @if (trakt.AntalProvytor > 0)
                                        {
                                            <a class="knapp-lank"
                                               href="@($"api/trakt/{trakt.TraktId}/provytor/geojson")"
                                               download="@($"trakt-{trakt.TraktId}-provytor.geojson")"
                                               title="Ladda ner provytor med kartmarkeringar som GeoJSON">
                                                ⬇ Provytor
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="insikter-tabell__tom">–</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="insikter-avvikelser">
                <div class="insikter-tabell__rubrik">Avvikelser / kommentarer</div>
                @{
                    var avvikelser = _statistik
                        .Where(t => _valda.Contains(t.TraktId))
                        .SelectMany(t => t.Avvikelser.Select(a => (Trakt: t, Avvikelse: a)))
                        .ToList();
                }
                @if (_valda.Count == 0)
                {
                    <div class="insikter-melding">Välj en eller flera trakter ovan för att se avvikelser.</div>
                }
                else if (avvikelser.Count == 0)
                {
                    <div class="insikter-melding">Inga avvikelser noterade på de valda trakterna.</div>
                }
                else
                {
                    <ul class="avvikelse-lista">
                        @foreach (var post in avvikelser)
                        {
                            <li class="avvikelse">
                                <div class="avvikelse__topp">
                                    <span class="avvikelse__trakt">@post.Trakt.Namn</span>
                                    <span class="avvikelse__ruta">Delområde #@post.Avvikelse.DelOmradeId</span>
                                    <span class="avvikelse__status avvikelse__status--@post.Avvikelse.Status.ToLowerInvariant()">
                                        @StatusText(post.Avvikelse.Status)
                                    </span>
                                </div>
                                <div class="avvikelse__text">@post.Avvikelse.Kommentar</div>
                            </li>
                        }
                    </ul>
                }
            </div>
            }
            else
            {
            <div class="insikter-inventeringar">
                <div class="insikter-tabell__rubrik">Inventeringar</div>
                @if (_inskickadeInventeringar.Count == 0)
                {
                    <div class="insikter-melding">Inga inventeringar har registrerats ännu.</div>
                }
                else
                {
                    <table class="tabell">
                        <thead>
                            <tr>
                                <th>Trakt</th>
                                <th>Inventerare</th>
                                <th class="tabell__num">Provytor</th>
                                <th class="tabell__num">Plantor</th>
                                <th class="tabell__num">Uppdaterad</th>
                                <th class="tabell__num">Karta</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in _inskickadeInventeringar)
                            {
                                <tr>
                                    <td>@(inv.TraktNamn ?? $"Trakt {inv.TraktId}")</td>
                                    <td>@(string.IsNullOrWhiteSpace(inv.TilldeladAnvandare) ? "–" : inv.TilldeladAnvandare)</td>
                                    <td class="tabell__num">@inv.AntalProvytor</td>
                                    <td class="tabell__num">@inv.TotaltAntalPlantor.ToString("N0", CultureInfo.CurrentCulture)</td>
                                    <td class="tabell__num">@inv.SkapadDatum.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                    <td class="tabell__num">
                                        @if (inv.AntalProvytor > 0)
                                        {
                                            <a class="knapp-lank"
                                               href="@($"api/inventering/{inv.Id}/provytor/geojson")"
                                               download="@($"inventering-{inv.Id}-provytor.geojson")"
                                               title="Ladda ner inventeringens provytor som GeoJSON">
                                                ⬇ Provytor
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="insikter-tabell__tom">–</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            }
        }
    </div>
</div>

@code {
    private enum InsiktVy { Plantering, Inventering }

    private InsiktVy _vy = InsiktVy.Plantering;

    private List<TraktStatistik>? _statistik;
    private readonly HashSet<int> _valda = new();
    private string? _loadError;

    private List<InventeringItem> _inskickadeInventeringar = new();

    private Summering _summering = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient();
            _statistik = await client.GetFromJsonAsync<List<TraktStatistik>>(
                $"{NavigationManager.BaseUri}api/trakt/statistik");

            // Markera alla trakter som standard så vyn visar en helhet direkt.
            if (_statistik is not null)
            {
                foreach (var trakt in _statistik)
                {
                    _valda.Add(trakt.TraktId);
                }
                RaknaOmSummering();
            }

            // Hämta inventeringsomgångar för uppföljningen.
            _inskickadeInventeringar = await client.GetFromJsonAsync<List<InventeringItem>>(
                $"{NavigationManager.BaseUri}api/inventering") ?? new();
        }
        catch (Exception ex)
        {
            _loadError = $"Kunde inte hämta statistik: {ex.Message}";
        }
    }

    private void OnTraktToggle(int traktId, ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
        {
            _valda.Add(traktId);
        }
        else
        {
            _valda.Remove(traktId);
        }

        RaknaOmSummering();
    }

    private void MarkeraAlla()
    {
        if (_statistik is null)
        {
            return;
        }

        foreach (var trakt in _statistik)
        {
            _valda.Add(trakt.TraktId);
        }

        RaknaOmSummering();
    }

    private void RensaVal()
    {
        _valda.Clear();
        RaknaOmSummering();
    }

    // Räknar om den aggregerade summeringen utifrån de valda trakterna.
    private void RaknaOmSummering()
    {
        if (_statistik is null)
        {
            _summering = new Summering();
            return;
        }

        var valda = _statistik.Where(t => _valda.Contains(t.TraktId)).ToList();
        var totalAreal = valda.Sum(t => t.TotalAreal);
        var klarAreal = valda.Sum(t => t.KlarAreal);

        _summering = new Summering
        {
            AntalDelomraden = valda.Sum(t => t.AntalDelomraden),
            AntalKlara = valda.Sum(t => t.AntalKlara),
            TotalAreal = totalAreal,
            ProcentKlar = totalAreal > 0 ? klarAreal / totalAreal * 100d : 0d,
            TotaltAntalPlantor = valda.Sum(t => t.TotaltAntalPlantor),
            MalTotaltAntalPlantor = valda.Sum(t => t.MalTotaltAntalPlantor),
            AntalProvytor = valda.Sum(t => t.AntalProvytor),
            AntalAvvikelser = valda.Sum(t => t.Avvikelser.Count)
        };
    }

    private static string StatusText(string status) => status switch
    {
        "Klar" => "Klar",
        "Paborjad" => "Påbörjad",
        _ => "Ej påbörjad"
    };

    private sealed class TraktStatistik
    {
        public int TraktId { get; set; }
        public string Namn { get; set; } = "";
        public int AntalDelomraden { get; set; }
        public double TotalAreal { get; set; }
        public double KlarAreal { get; set; }
        public double ProcentKlar { get; set; }
        public int AntalKlara { get; set; }
        public int TotaltAntalPlantor { get; set; }
        public int MalTotaltAntalPlantor { get; set; }
        public int AntalProvytor { get; set; }
        public List<DelOmradeAvvikelse> Avvikelser { get; set; } = new();
    }

    private sealed class DelOmradeAvvikelse
    {
        public int DelOmradeId { get; set; }
        public string Kommentar { get; set; } = "";
        public string Status { get; set; } = "";
    }

    private sealed class InventeringItem
    {
        public int Id { get; set; }
        public int TraktId { get; set; }
        public string? TraktNamn { get; set; }
        public DateTime SkapadDatum { get; set; }
        public string? TilldeladAnvandare { get; set; }
        public PlantApp.Models.InventeringStatus Status { get; set; }
        public int AntalProvytor { get; set; }
        public int TotaltAntalPlantor { get; set; }
    }

    private sealed class Summering
    {
        public int AntalDelomraden { get; set; }
        public int AntalKlara { get; set; }
        public double TotalAreal { get; set; }
        public double ProcentKlar { get; set; }
        public int TotaltAntalPlantor { get; set; }
        public int MalTotaltAntalPlantor { get; set; }
        public int AntalProvytor { get; set; }
        public int AntalAvvikelser { get; set; }

        /// <summary>Andel av målet som är uppnått, 0–100 (%). 0 om inget mål är satt.</summary>
        public double ProcentAvMal =>
            MalTotaltAntalPlantor > 0 ? (double)TotaltAntalPlantor / MalTotaltAntalPlantor * 100d : 0d;
    }
}
