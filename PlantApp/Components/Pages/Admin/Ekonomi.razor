@page "/admin/ekonomi"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Globalization
@using PlantApp.Models
@using PlantApp.Dtos
@using PlantApp.Services
@attribute [Authorize(Roles = "Admin")]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>PlantApp – Ekonomi</PageTitle>

<div class="ekonomi-page">
    <div class="ekonomi-card card-soft">
        <div class="ekonomi-card__header">
            <div class="ekonomi-card__brand">
                <span class="ekonomi-card__logo" aria-hidden="true">💰</span>
                <div>
                    <h1 class="ekonomi-card__titel">Ekonomi</h1>
                    <p class="ekonomi-card__subtitel">Underlag för ackord och lön – registrerade plantor och timmar per period.</p>
                </div>
            </div>
            <a class="btn-pill btn-pill--ghost" href="/admin">Till admin</a>
        </div>

        @if (_loadError is not null)
        {
            <div class="ekonomi-melding ekonomi-melding--fel">@_loadError</div>
        }

        <div class="ekonomi-installning">
            <div class="ekonomi-tabell__rubrik">Standardersättningsform</div>
            <p class="ekonomi-hjalp">
                Gäller för alla trakter och delområden som inte har en egen ersättningsform. Appen räknar inte ut
                ersättning – detta är underlag som ekonomiavdelningen använder.
            </p>
            <div class="ekonomi-installning__val">
                <select class="ekonomi-select" value="@((int)_standardTyp)"
                        @onchange="OnStandardTypChanged" disabled="@_sparar">
                    @foreach (var typ in AllaTyper)
                    {
                        <option value="@((int)typ)">@TypText(typ)</option>
                    }
                </select>
                @if (_sparar)
                {
                    <span class="ekonomi-installning__status">Sparar…</span>
                }
            </div>
        </div>

        <div class="ekonomi-filter">
            <div class="ekonomi-filter__falt">
                <label for="fran">Från</label>
                <input id="fran" type="date" class="ekonomi-input" @bind="_fran" />
            </div>
            <div class="ekonomi-filter__falt">
                <label for="till">Till</label>
                <input id="till" type="date" class="ekonomi-input" @bind="_till" />
            </div>
            <div class="ekonomi-filter__knappar">
                <button type="button" class="btn-pill" @onclick="LaddaSammanstallning" disabled="@_laddar">
                    @(_laddar ? "Hämtar…" : "Uppdatera")
                </button>
                <button type="button" class="knapp-lank" @onclick="RensaPeriod" disabled="@_laddar">Rensa period</button>
            </div>
        </div>

        @if (_rader is null)
        {
            <div class="ekonomi-melding">Laddar sammanställning…</div>
        }
        else
        {
            <div class="ekonomi-summering">
                <div class="stat-kort">
                    <span class="stat-kort__ikon" aria-hidden="true">🌱</span>
                    <div class="stat-kort__varde">@_rader.Sum(r => r.AntalPlantor).ToString("N0", CultureInfo.CurrentCulture)</div>
                    <div class="stat-kort__etikett">Registrerade plantor</div>
                </div>
                <div class="stat-kort">
                    <span class="stat-kort__ikon" aria-hidden="true">👥</span>
                    <div class="stat-kort__varde">@_personer.Count</div>
                    <div class="stat-kort__etikett">Plantsättare</div>
                </div>
                <div class="stat-kort">
                    <span class="stat-kort__ikon" aria-hidden="true">🗂️</span>
                    <div class="stat-kort__varde">@_rader.Select(r => r.TraktId).Distinct().Count()</div>
                    <div class="stat-kort__etikett">Trakter</div>
                </div>
                <div class="stat-kort">
                    <span class="stat-kort__ikon" aria-hidden="true">⏱️</span>
                    <div class="stat-kort__varde">@_personer.Sum(p => p.TimmarTotalt).ToString("0.##", CultureInfo.CurrentCulture)</div>
                    <div class="stat-kort__etikett">Rapporterade timmar</div>
                </div>
            </div>

            <div class="ekonomi-tabell">
                <div class="ekonomi-tabell__topp">
                    <div class="ekonomi-tabell__rubrik">Per plantsättare</div>
                    @if (_personer.Count > 0)
                    {
                        <button type="button" class="btn-pill btn-pill--ghost"
                                @onclick="ExporteraTillExcel" disabled="@_exporterar">
                            <span aria-hidden="true">📄</span>
                            @(_exporterar ? "Exporterar…" : "Exportera till Excel")
                        </button>
                    }
                </div>

                @if (_personer.Count == 0)
                {
                    <div class="ekonomi-melding">Inga registrerade plantor i vald period.</div>
                }
                else
                {
                    <table class="tabell">
                        <thead>
                            <tr>
                                <th>Plantsättare</th>
                                <th class="tabell__num">Trakter</th>
                                <th class="tabell__num">Plantor</th>
                                <th class="tabell__num">Timmar (ack.)</th>
                                <th class="tabell__num">Timmar (timlön)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var person in _personer)
                            {
                                var arVald = _valdPerson == person.Namn;
                                <tr class="ekonomi-person-rad @(arVald ? "ekonomi-person-rad--vald" : "")"
                                    @onclick="() => ValjPerson(person.Namn)">
                                    <td>
                                        <span class="ekonomi-person-rad__pil" aria-hidden="true">@(arVald ? "▼" : "▶")</span>
                                        @person.Namn
                                    </td>
                                    <td class="tabell__num">@person.AntalTrakter</td>
                                    <td class="tabell__num">@person.TotaltAntalPlantor.ToString("N0", CultureInfo.CurrentCulture)</td>
                                    <td class="tabell__num">@person.TimmarAckord.ToString("0.##", CultureInfo.CurrentCulture)</td>
                                    <td class="tabell__num">@person.TimmarTimpenning.ToString("0.##", CultureInfo.CurrentCulture)</td>
                                    <td class="tabell__num">
                                        <span class="knapp-lank">@(arVald ? "Dölj" : "Detaljer")</span>
                                    </td>
                                </tr>
                                @if (arVald)
                                {
                                    <tr class="ekonomi-detalj-rad">
                                        <td colspan="6">
                                            <div class="ekonomi-detalj">
                                                <div class="ekonomi-detalj__rubrik">@person.Namn – per trakt</div>
                                                <table class="tabell tabell--inbaddad">
                                                    <thead>
                                                        <tr>
                                                            <th>Trakt</th>
                                                            <th class="tabell__num">Plantor</th>
                                                            <th>Ersättningsform</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var trakt in person.Trakter)
                                                        {
                                                            <tr>
                                                                <td>@trakt.TraktNamn</td>
                                                                <td class="tabell__num">@trakt.AntalPlantor.ToString("N0", CultureInfo.CurrentCulture)</td>
                                                                <td>@trakt.ErsattningsFormer</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                                <div class="ekonomi-detalj__rubrik">@person.Namn – rapporterade timmar</div>
                                                @if (person.TimmarTotalt <= 0)
                                                {
                                                    <p class="ekonomi-hjalp">Inga timmar rapporterade i vald period.</p>
                                                }
                                                else
                                                {
                                                    <div class="ekonomi-tim-chips">
                                                        <span class="tid-chip">Helackord: @person.TimmarHelackord.ToString("0.##", CultureInfo.CurrentCulture) h</span>
                                                        <span class="tid-chip">Delackord: @person.TimmarDelackord.ToString("0.##", CultureInfo.CurrentCulture) h</span>
                                                        <span class="tid-chip">Timpenning: @person.TimmarTimpenning.ToString("0.##", CultureInfo.CurrentCulture) h</span>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    </div>
</div>

@code {
    private static readonly ErsattningsTyp[] AllaTyper =
        Enum.GetValues<ErsattningsTyp>();

    private List<EkonomiRadDto>? _rader;
    private List<TidrapportSummeringDto> _timmar = new();
    private List<PersonSammanstallning> _personer = new();
    private string? _valdPerson;
    private string? _loadError;

    private ErsattningsTyp _standardTyp = ErsattningsTyp.HelAckord;
    private DateTime? _fran;
    private DateTime? _till;

    private bool _laddar;
    private bool _sparar;
    private bool _exporterar;

    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        await LaddaInstallningAsync();
        await LaddaSammanstallning();
    }

    private async Task LaddaInstallningAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient();
            var installning = await client.GetFromJsonAsync<EkonomiInstallningDto>(
                $"{NavigationManager.BaseUri}api/ekonomi/installning");

            if (installning is not null)
            {
                _standardTyp = installning.StandardErsattningsTyp;
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Kunde inte hämta inställning: {ex.Message}";
        }
    }

    private async Task LaddaSammanstallning()
    {
        _laddar = true;
        _loadError = null;

        try
        {
            var query = new List<string>();
            if (_fran is { } f)
            {
                query.Add($"fran={f:yyyy-MM-dd}");
            }
            if (_till is { } t)
            {
                query.Add($"till={t:yyyy-MM-dd}");
            }

            var url = $"{NavigationManager.BaseUri}api/ekonomi/sammanstallning";
            if (query.Count > 0)
            {
                url += "?" + string.Join("&", query);
            }

            var client = HttpClientFactory.CreateClient();
            _rader = await client.GetFromJsonAsync<List<EkonomiRadDto>>(url) ?? new();

            var timUrl = $"{NavigationManager.BaseUri}api/tidrapport/sammanstallning";
            if (query.Count > 0)
            {
                timUrl += "?" + string.Join("&", query);
            }
            _timmar = await client.GetFromJsonAsync<List<TidrapportSummeringDto>>(timUrl) ?? new();

            ByggPersoner();
        }
        catch (Exception ex)
        {
            _loadError = $"Kunde inte hämta sammanställning: {ex.Message}";
        }
        finally
        {
            _laddar = false;
        }
    }

    private void ByggPersoner()
    {
        if (_rader is null)
        {
            _personer = new();
            return;
        }

        var personer = _rader
            .GroupBy(r => r.Plantsattare)
            .Select(g => new PersonSammanstallning
            {
                Namn = g.Key,
                TotaltAntalPlantor = g.Sum(r => r.AntalPlantor),
                AntalTrakter = g.Select(r => r.TraktId).Distinct().Count(),
                Trakter = g
                    .GroupBy(r => new { r.TraktId, r.TraktNamn })
                    .Select(tg => new PersonTrakt
                    {
                        TraktNamn = tg.Key.TraktNamn,
                        AntalPlantor = tg.Sum(r => r.AntalPlantor),
                        ErsattningsFormer = string.Join(", ", tg
                            .Select(r => TypText(r.ErsattningsTyp))
                            .Distinct()
                            .OrderBy(t => t))
                    })
                    .OrderBy(t => t.TraktNamn)
                    .ToList()
            })
            .ToDictionary(p => p.Namn);

        // Slå ihop timmar per person (kan finnas personer som bara rapporterat tid).
        foreach (var tim in _timmar)
        {
            if (!personer.TryGetValue(tim.Anvandare, out var person))
            {
                person = new PersonSammanstallning { Namn = tim.Anvandare };
                personer[tim.Anvandare] = person;
            }

            person.TimmarHelackord = tim.TimmarHelackord;
            person.TimmarDelackord = tim.TimmarDelackord;
            person.TimmarTimpenning = tim.TimmarTimpenning;
        }

        _personer = personer.Values
            .OrderByDescending(p => p.TotaltAntalPlantor)
            .ThenByDescending(p => p.TimmarTotalt)
            .ThenBy(p => p.Namn)
            .ToList();

        if (_valdPerson is not null && _personer.All(p => p.Namn != _valdPerson))
        {
            _valdPerson = null;
        }
    }

    private void ValjPerson(string namn)
    {
        _valdPerson = _valdPerson == namn ? null : namn;
    }

    private async Task OnStandardTypChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var value))
        {
            return;
        }

        var nyTyp = (ErsattningsTyp)value;
        _sparar = true;
        _loadError = null;

        try
        {
            var client = HttpClientFactory.CreateClient();
            var response = await client.PutAsJsonAsync(
                $"{NavigationManager.BaseUri}api/ekonomi/installning",
                new EkonomiInstallningDto { StandardErsattningsTyp = nyTyp });

            if (response.IsSuccessStatusCode)
            {
                _standardTyp = nyTyp;
                // Ladda om så att raderna som ärver standarden uppdateras.
                await LaddaSammanstallning();
            }
            else
            {
                _loadError = $"Kunde inte spara inställning (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Fel vid sparande: {ex.Message}";
        }
        finally
        {
            _sparar = false;
        }
    }

    private async Task RensaPeriod()
    {
        _fran = null;
        _till = null;
        await LaddaSammanstallning();
    }

    private async Task ExporteraTillExcel()
    {
        if (_exporterar || _personer.Count == 0)
        {
            return;
        }

        _exporterar = true;
        try
        {
            var headers = new[]
            {
                "Plantsättare", "Trakt", "Plantor", "Ersättningsform"
            };

            var rows = new List<IReadOnlyList<SimpleXlsx.Cell>>();
            foreach (var person in _personer)
            {
                foreach (var trakt in person.Trakter)
                {
                    rows.Add(new[]
                    {
                        SimpleXlsx.Cell.Str(person.Namn),
                        SimpleXlsx.Cell.Str(trakt.TraktNamn),
                        SimpleXlsx.Cell.Num(trakt.AntalPlantor),
                        SimpleXlsx.Cell.Str(trakt.ErsattningsFormer)
                    });
                }
            }

            // Summeringsrad.
            rows.Add(new[]
            {
                SimpleXlsx.Cell.Str("Totalt"),
                SimpleXlsx.Cell.Empty,
                SimpleXlsx.Cell.Num(_personer.Sum(p => p.TotaltAntalPlantor)),
                SimpleXlsx.Cell.Empty
            });

            // Tom rad + rubrik för timmar per person och ersättningsform.
            rows.Add(new[] { SimpleXlsx.Cell.Empty, SimpleXlsx.Cell.Empty, SimpleXlsx.Cell.Empty, SimpleXlsx.Cell.Empty });
            rows.Add(new[]
            {
                SimpleXlsx.Cell.Str("Timmar per plantsättare"),
                SimpleXlsx.Cell.Str("Helackord"),
                SimpleXlsx.Cell.Str("Delackord"),
                SimpleXlsx.Cell.Str("Timpenning")
            });
            foreach (var person in _personer.Where(p => p.TimmarTotalt > 0))
            {
                rows.Add(new[]
                {
                    SimpleXlsx.Cell.Str(person.Namn),
                    SimpleXlsx.Cell.Num(person.TimmarHelackord),
                    SimpleXlsx.Cell.Num(person.TimmarDelackord),
                    SimpleXlsx.Cell.Num(person.TimmarTimpenning)
                });
            }

            var bytes = SimpleXlsx.Create("Ekonomi", headers, rows);
            var base64 = Convert.ToBase64String(bytes);
            var filnamn = $"ekonomi-underlag-{DateTime.Now:yyyy-MM-dd}.xlsx";

            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Components/Pages/Admin/Ekonomi.razor.js");
            await _module.InvokeVoidAsync(
                "downloadFile",
                filnamn,
                base64,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        catch (Exception ex)
        {
            _loadError = $"Kunde inte exportera: {ex.Message}";
        }
        finally
        {
            _exporterar = false;
        }
    }

    private static string TypText(ErsattningsTyp typ) => typ switch
    {
        ErsattningsTyp.HelAckord => "Helackord",
        ErsattningsTyp.DelAckord => "Delackord",
        ErsattningsTyp.Timpenning => "Timpenning",
        _ => typ.ToString()
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Kretsen är redan nedkopplad – inget att städa.
            }
        }
    }

    private sealed class PersonSammanstallning
    {
        public string Namn { get; set; } = "";
        public int TotaltAntalPlantor { get; set; }
        public int AntalTrakter { get; set; }
        public List<PersonTrakt> Trakter { get; set; } = new();

        public double TimmarHelackord { get; set; }
        public double TimmarDelackord { get; set; }
        public double TimmarTimpenning { get; set; }

        public double TimmarAckord => TimmarHelackord + TimmarDelackord;
        public double TimmarTotalt => TimmarHelackord + TimmarDelackord + TimmarTimpenning;
    }

    private sealed class PersonTrakt
    {
        public string TraktNamn { get; set; } = "";
        public int AntalPlantor { get; set; }
        public string ErsattningsFormer { get; set; } = "";
    }
}
