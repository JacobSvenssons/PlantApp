@page "/admin/trakter"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Globalization
@using PlantApp.Models
@using PlantApp.Services
@attribute [Authorize(Roles = "Admin")]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject PlantApp.Services.DemoUserStore DemoUserStore

<PageTitle>PlantApp – Hantera trakter</PageTitle>

<div class="trakter-page">
    <div class="trakter-card card-soft">
        <div class="trakter-card__header">
            <div class="trakter-card__brand">
                <span class="trakter-card__logo" aria-hidden="true">🗂️</span>
                <div>
                    <h1 class="trakter-card__titel">Hantera trakter</h1>
                    <p class="trakter-card__subtitel">Radera trakter du inte längre behöver.</p>
                </div>
            </div>
            <a class="btn-pill btn-pill--ghost" href="/admin">Till admin</a>
        </div>

        @if (_loadError is not null)
        {
            <div class="trakter-melding trakter-melding--fel">@_loadError</div>
        }
        else if (_trakter is null)
        {
            <div class="trakter-melding">Laddar trakter…</div>
        }
        else if (_trakter.Count == 0)
        {
            <div class="trakter-melding">
                Inga trakter finns ännu. Lägg till en ny trakt på
                <a href="/admin/upload">adminsidan</a>.
            </div>
        }
        else
        {
            @if (_message is not null)
            {
                <div class="trakter-melding trakter-melding--ok">@_message</div>
            }

            <table class="tabell">
                <thead>
                    <tr>
                        <th>Trakt</th>
                        <th class="tabell__num">Delområden</th>
                        <th class="tabell__num">Provytor</th>
                        <th class="tabell__num">Plantor</th>
                        <th>Status</th>
                        <th>Skapad</th>
                        <th>Inventering möjlig</th>
                        <th>Ersättningsform</th>
                        <th class="tabell__actions">Åtgärd</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trakt in _trakter)
                    {
                        <tr>
                            <td>@trakt.Namn</td>
                            <td class="tabell__num">@trakt.AntalDelomraden</td>
                            <td class="tabell__num">@trakt.AntalProvytor</td>
                            <td class="tabell__num">@trakt.TotaltAntalPlantor</td>
                            <td>@trakt.Status</td>
                            <td>@trakt.SkapadDatum.ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.CurrentCulture)</td>
                            <td>
                                <label class="inventering-toggle">
                                    <input type="checkbox" checked="@trakt.InventeringMojlig"
                                           @onchange="e => SetInventeringMojligAsync(trakt.Id, e)"
                                           disabled="@(_uppdaterarInventering == trakt.Id)" />
                                    <span>@(trakt.InventeringMojlig ? "Öppen" : "Stängd")</span>
                                </label>
                            </td>
                            <td>
                                <select class="ersattning-select" value="@ErsattningsVal(trakt.ErsattningsTyp)"
                                        @onchange="e => SetErsattningsTypAsync(trakt.Id, e)"
                                        disabled="@(_uppdaterarErsattning == trakt.Id)">
                                    <option value="">Standard (ärv)</option>
                                    @foreach (var typ in AllaErsattningsTyper)
                                    {
                                        <option value="@((int)typ)">@ErsattningsTypText(typ)</option>
                                    }
                                </select>
                            </td>
                            <td class="tabell__actions">
                                <button type="button" class="knapp-fara knapp-fara--sekundar"
                                        @onclick="() => BegarRadera(trakt.Id)" disabled="@_raderar">
                                    Radera
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (_bekraftaId is { } bekraftaId && _trakter?.FirstOrDefault(t => t.Id == bekraftaId) is { } bekraftaTrakt)
{
    <div class="bekrafta-overlay" @onclick="AvbrytRadera">
        <div class="bekrafta-modal" @onclick:stopPropagation="true">
            <h2 class="bekrafta-modal__titel">Radera trakt?</h2>
            <p class="bekrafta-modal__text">Detta raderas permanent:</p>
            <ul class="bekrafta-modal__lista">
                <li>Trakten <strong>@bekraftaTrakt.Namn</strong></li>
                <li>@bekraftaTrakt.AntalDelomraden delområden</li>
                <li>@bekraftaTrakt.AntalProvytor provytor</li>
                <li>@bekraftaTrakt.TotaltAntalPlantor registrerade plantor</li>
            </ul>
            <div class="bekrafta-modal__knappar">
                <button type="button" class="knapp-lank" @onclick="AvbrytRadera" disabled="@_raderar">
                    Avbryt
                </button>
                <button type="button" class="knapp-fara" @onclick="() => RaderaAsync(bekraftaTrakt.Id)" disabled="@_raderar">
                    @(_raderar ? "Raderar…" : "Ja, radera allt")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<TraktListItem>? _trakter;
    private string? _loadError;
    private string? _message;

    private int? _bekraftaId;
    private bool _raderar;

    private int? _uppdaterarInventering;
    private int? _uppdaterarErsattning;

    private static readonly ErsattningsTyp[] AllaErsattningsTyper = Enum.GetValues<ErsattningsTyp>();

    private static string ErsattningsVal(ErsattningsTyp? typ) =>
        typ is { } t ? ((int)t).ToString() : "";

    private static string ErsattningsTypText(ErsattningsTyp typ) => typ switch
    {
        ErsattningsTyp.HelAckord => "Helackord",
        ErsattningsTyp.DelAckord => "Delackord",
        ErsattningsTyp.Timpenning => "Timpenning",
        _ => typ.ToString()
    };

    protected override async Task OnInitializedAsync()
    {
        await LaddaTrakterAsync();
    }

    private async Task SetInventeringMojligAsync(int traktId, ChangeEventArgs e)
    {
        var mojlig = e.Value is bool b && b;
        _uppdaterarInventering = traktId;
        _message = null;
        _loadError = null;

        try
        {
            var client = HttpClientFactory.CreateClient();
            var response = await client.PutAsJsonAsync(
                $"{NavigationManager.BaseUri}api/trakt/{traktId}/inventering-mojlig",
                new { Mojlig = mojlig });

            var trakt = _trakter?.FirstOrDefault(t => t.Id == traktId);
            if (response.IsSuccessStatusCode)
            {
                if (trakt is not null)
                {
                    trakt.InventeringMojlig = mojlig;
                }

                var namn = trakt?.Namn;
                _message = mojlig
                    ? $"\"{namn}\" är nu öppen för inventering."
                    : $"\"{namn}\" är inte längre öppen för inventering.";
            }
            else
            {
                _loadError = $"Kunde inte uppdatera inventeringsstatus (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Fel vid uppdatering av inventeringsstatus: {ex.Message}";
        }
        finally
        {
            _uppdaterarInventering = null;
        }
    }

    private async Task SetErsattningsTypAsync(int traktId, ChangeEventArgs e)
    {
        ErsattningsTyp? typ = int.TryParse(e.Value?.ToString(), out var value)
            ? (ErsattningsTyp)value
            : null;

        _uppdaterarErsattning = traktId;
        _message = null;
        _loadError = null;

        try
        {
            var client = HttpClientFactory.CreateClient();
            var response = await client.PutAsJsonAsync(
                $"{NavigationManager.BaseUri}api/ekonomi/trakt/{traktId}/ersattningstyp",
                new { ErsattningsTyp = typ });

            var trakt = _trakter?.FirstOrDefault(t => t.Id == traktId);
            if (response.IsSuccessStatusCode)
            {
                if (trakt is not null)
                {
                    trakt.ErsattningsTyp = typ;
                }

                var namn = trakt?.Namn;
                _message = typ is { } t
                    ? $"\"{namn}\" använder nu {ErsattningsTypText(t).ToLowerInvariant()}."
                    : $"\"{namn}\" använder nu standardersättningsformen.";
            }
            else
            {
                _loadError = $"Kunde inte uppdatera ersättningsform (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Fel vid uppdatering av ersättningsform: {ex.Message}";
        }
        finally
        {
            _uppdaterarErsattning = null;
        }
    }

    private async Task LaddaTrakterAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient();
            _trakter = await client.GetFromJsonAsync<List<TraktListItem>>(
                $"{NavigationManager.BaseUri}api/trakt");
        }
        catch (Exception ex)
        {
            _loadError = $"Kunde inte hämta trakter: {ex.Message}";
        }
    }

    private void BegarRadera(int traktId)
    {
        _bekraftaId = traktId;
        _message = null;
    }

    private void AvbrytRadera()
    {
        _bekraftaId = null;
    }

    private async Task RaderaAsync(int traktId)
    {
        _raderar = true;
        _message = null;

        try
        {
            var namn = _trakter?.FirstOrDefault(t => t.Id == traktId)?.Namn;

            var client = HttpClientFactory.CreateClient();
            var response = await client.DeleteAsync(
                $"{NavigationManager.BaseUri}api/trakt/{traktId}");

            if (response.IsSuccessStatusCode)
            {
                _trakter?.RemoveAll(t => t.Id == traktId);
                _bekraftaId = null;
                _message = $"Trakten \"{namn}\" raderades.";
            }
            else
            {
                _loadError = $"Kunde inte radera trakten (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Fel vid radering: {ex.Message}";
        }
        finally
        {
            _raderar = false;
        }
    }

    private sealed class TraktListItem
    {
        public int Id { get; set; }
        public string Namn { get; set; } = "";
        public string? Status { get; set; }
        public DateTime SkapadDatum { get; set; }
        public int AntalDelomraden { get; set; }
        public int AntalProvytor { get; set; }
        public int TotaltAntalPlantor { get; set; }
        public bool InventeringMojlig { get; set; }
        public ErsattningsTyp? ErsattningsTyp { get; set; }
    }
}
