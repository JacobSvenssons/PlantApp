@page "/"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using PlantApp.Models
@using PlantApp.Services
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
<PageTitle>PlantApp – Välj trakt</PageTitle>

<div class="start-page">
    <div class="start-card card-soft">
        <div class="start-card__brand">
            <span class="start-card__logo" aria-hidden="true">🌲</span>
            <div>
                <h1 class="start-card__titel">PlantApp</h1>
                <p class="start-card__subtitel">
                    @(_vy == Vy.Inventering
                        ? "Välj en omgång för att öppna inventeringen."
                        : "Välj en trakt för att öppna planteringskartan.")
                </p>
            </div>
        </div>

        <div class="offline-forbered">
            <button class="btn-pill btn-pill--sekundar" @onclick="ForberedOffline" disabled="@_forberederOffline">
                @(_forberederOffline ? "Laddar ner…" : "⬇ Förbered offline")
            </button>
            <a class="offline-forbered__lank" href="/falt/">Öppna fältläge →</a>
            @if (_offlineStatus is not null)
            {
                <div class="offline-forbered__status">@_offlineStatus</div>
            }
        </div>

        @if (_kanInventera)
        {
            <div class="start-vaxel" role="tablist" aria-label="Välj vy">
                <button type="button" role="tab" aria-selected="@(_vy == Vy.Plantering)"
                        class="start-vaxel__knapp @(_vy == Vy.Plantering ? "start-vaxel__knapp--aktiv" : null)"
                        @onclick="() => BytVy(Vy.Plantering)">
                    🌱 Plantering
                </button>
                <button type="button" role="tab" aria-selected="@(_vy == Vy.Inventering)"
                        class="start-vaxel__knapp @(_vy == Vy.Inventering ? "start-vaxel__knapp--aktiv" : null)"
                        @onclick="() => BytVy(Vy.Inventering)">
                    📋 Inventering
                </button>
            </div>
        }

        @if (_loadError is not null)
        {
            <div class="start-melding start-melding--fel">@_loadError</div>
        }
        else if (_vy == Vy.Inventering)
        {
            @if (_inventeringsTrakter is null)
            {
                <div class="start-melding">Laddar trakter…</div>
            }
            else if (_inventeringsTrakter.Count == 0)
            {
                <div class="start-melding">Inga trakter är öppnade för inventering ännu.</div>
            }
            else
            {
                <div class="start-falt">
                    <label for="inventering-val">Trakt</label>
                    <select id="inventering-val" class="start-select" @bind="_selectedInventeringTraktId">
                        <option value="0" disabled>– Välj trakt –</option>
                        @foreach (var trakt in _inventeringsTrakter)
                        {
                            <option value="@trakt.Id">@trakt.Namn (@trakt.AntalDelomraden delområden)</option>
                        }
                    </select>
                </div>

                <div class="start-actions">
                    <button class="btn-pill" disabled="@(_selectedInventeringTraktId <= 0 || _startarInventering)" @onclick="OpenInventering">
                        @(_startarInventering ? "Öppnar…" : "Öppna inventering")
                    </button>
                </div>
            }
        }
        else if (_trakter is null)
        {
            <div class="start-melding">Laddar trakter…</div>
        }
        else if (_trakter.Count == 0)
        {
            <div class="start-melding">
                Inga trakter finns ännu. Lägg till en ny trakt på
                <a href="/admin">adminsidan</a>.
            </div>
        }
        else
        {
            <div class="start-falt">
                <label for="trakt-val">Trakt</label>
                <select id="trakt-val" class="start-select" @bind="_selectedTraktId" @bind:after="OnTraktChanged">
                    <option value="0" disabled>– Välj trakt –</option>
                    @foreach (var trakt in _trakter)
                    {
                        <option value="@trakt.Id">@trakt.Namn (@trakt.AntalDelomraden delområden)</option>
                    }
                </select>
            </div>

            @* Primär åtgärd direkt efter trakt-valet – plantören vill öppna kartan snabbt. *@
            <div class="start-actions">
                <button class="btn-pill" disabled="@(_selectedTraktId <= 0)" @onclick="OpenKarta">
                    Öppna karta
                </button>
            </div>

            @if (_laddarStatistik)
            {
                <div class="start-melding">Laddar statistik…</div>
            }
            else if (_statistik is not null)
            {
                <div class="dashboard">
                    <div class="dashboard__header">
                        <h2 class="dashboard__titel">@_statistik.Namn</h2>
                        <span class="dashboard__badge">@_statistik.AntalDelomraden delområden</span>
                    </div>

                    <div class="dashboard__progress">
                        <div class="dashboard__progress-topp">
                            <span class="dashboard__progress-label">Färdigplanterat</span>
                            <span class="dashboard__progress-varde">@_statistik.ProcentKlar.ToString("0.#") %</span>
                        </div>
                        <div class="dashboard__bar" role="progressbar"
                             aria-valuenow="@((int)Math.Round(_statistik.ProcentKlar))" aria-valuemin="0" aria-valuemax="100">
                            <div class="dashboard__bar-fyll" style="width:@_statistik.ProcentKlar.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                        <span class="dashboard__progress-detalj">
                            @_statistik.KlarAreal.ToString("0.##") av @_statistik.TotalAreal.ToString("0.##") ha klara
                        </span>
                    </div>

                    <div class="dashboard__kort">
                        <div class="stat-kort">
                            <span class="stat-kort__ikon" aria-hidden="true">🌱</span>
                            <div class="stat-kort__varde">@_statistik.TotaltAntalPlantor.ToString("N0")</div>
                            <div class="stat-kort__etikett">Satta plantor</div>
                        </div>
                        <div class="stat-kort">
                            <span class="stat-kort__ikon" aria-hidden="true">✅</span>
                            <div class="stat-kort__varde">@_statistik.AntalKlara / @_statistik.AntalDelomraden</div>
                            <div class="stat-kort__etikett">Klara delområden</div>
                        </div>
                        <div class="stat-kort">
                            <span class="stat-kort__ikon" aria-hidden="true">📐</span>
                            <div class="stat-kort__varde">@_statistik.TotalAreal.ToString("0.##") ha</div>
                            <div class="stat-kort__etikett">Total areal</div>
                        </div>
                        @if (_kanSeAvvikelser)
                        {
                            <div class="stat-kort @(_statistik.Avvikelser.Count > 0 ? "stat-kort--varning" : null)">
                                <span class="stat-kort__ikon" aria-hidden="true">⚠️</span>
                                <div class="stat-kort__varde">@_statistik.Avvikelser.Count</div>
                                <div class="stat-kort__etikett">Avvikelser</div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<TraktListItem>? _trakter;
    private int _selectedTraktId;
    private string? _loadError;

    private bool _forberederOffline;
    private string? _offlineStatus;

    private TraktStatistik? _statistik;
    private bool _laddarStatistik;

    private bool _kanSeAvvikelser;

    // Inventeringsläge – bara tillgängligt för inventerare/admin.
    private enum Vy { Plantering, Inventering }
    private Vy _vy = Vy.Plantering;
    private bool _kanInventera;
    private bool _isAdmin;
    private List<TraktListItem>? _inventeringsTrakter;
    private int _selectedInventeringTraktId;
    private bool _startarInventering;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private async Task ForberedOffline()
    {
        _forberederOffline = true;
        _offlineStatus = "Laddar ner trakter och inventeringar…";
        try
        {
            var res = await JS.InvokeAsync<ForberedResultat>("PlantAppOffline.forberedAllt");
            _offlineStatus = $"Klart: {res.Trakter} trakter och {res.Inventeringar} inventeringar nedladdade"
                + (res.Fel > 0 ? $" ({res.Fel} kunde inte laddas)." : ".");
        }
        catch (Exception ex)
        {
            _offlineStatus = "Nedladdning misslyckades: " + ex.Message;
        }
        finally
        {
            _forberederOffline = false;
        }
    }

    private sealed class ForberedResultat
    {
        public int Trakter { get; set; }
        public int Inventeringar { get; set; }
        public int Fel { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _isAdmin = user.IsInRole(DemoUserStore.RoleAdmin);
            // Avvikelser är ett översiktsverktyg för admin/plantbas.
            _kanSeAvvikelser = _isAdmin || user.IsInRole(DemoUserStore.RolePlantbas);
            // Inventeringsvyn visas för inventerare och admin.
            _kanInventera = _isAdmin || user.IsInRole(DemoUserStore.RoleInventerare);
        }

        try
        {
            var client = HttpClientFactory.CreateClient();
            _trakter = await client.GetFromJsonAsync<List<TraktListItem>>(
                $"{NavigationManager.BaseUri}api/trakt");
        }
        catch (Exception ex)
        {
            _loadError = $"Kunde inte hämta trakter: {ex.Message}";
        }
    }

    private async Task BytVy(Vy vy)
    {
        if (_vy == vy)
        {
            return;
        }

        _vy = vy;
        _loadError = null;

        // Ladda inventeringar första gången användaren växlar till inventeringsvyn.
        if (vy == Vy.Inventering && _inventeringsTrakter is null)
        {
            LaddaInventeringsTrakter();
        }
    }

    private void LaddaInventeringsTrakter()
    {
        // Visa bara trakter som admin har öppnat för inventering.
        _inventeringsTrakter = _trakter?
            .Where(t => t.InventeringMojlig)
            .ToList() ?? new();
    }

    private async Task OpenInventering()
    {
        if (_selectedInventeringTraktId <= 0)
        {
            return;
        }

        _startarInventering = true;
        _loadError = null;

        try
        {
            var client = HttpClientFactory.CreateClient();
            var response = await client.PostAsJsonAsync(
                $"{NavigationManager.BaseUri}api/inventering/starta",
                new { TraktId = _selectedInventeringTraktId });

            if (response.IsSuccessStatusCode)
            {
                var inventering = await response.Content.ReadFromJsonAsync<InventeringListItem>();
                if (inventering is not null)
                {
                    NavigationManager.NavigateTo($"/inventering/{inventering.Id}");
                }
                else
                {
                    _loadError = "Kunde inte öppna inventeringen.";
                }
            }
            else
            {
                _loadError = $"Kunde inte öppna inventeringen (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Fel vid start av inventering: {ex.Message}";
        }
        finally
        {
            _startarInventering = false;
        }
    }

    private async Task OnTraktChanged()
    {
        _statistik = null;

        if (_selectedTraktId <= 0)
        {
            return;
        }

        _laddarStatistik = true;
        try
        {
            var client = HttpClientFactory.CreateClient();
            _statistik = await client.GetFromJsonAsync<TraktStatistik>(
                $"{NavigationManager.BaseUri}api/trakt/{_selectedTraktId}/statistik");
        }
        catch (Exception ex)
        {
            _loadError = $"Kunde inte hämta statistik: {ex.Message}";
        }
        finally
        {
            _laddarStatistik = false;
        }
    }

    private void OpenKarta()
    {
        if (_selectedTraktId > 0)
        {
            NavigationManager.NavigateTo($"/trakt/{_selectedTraktId}");
        }
    }

    private sealed class TraktListItem
    {
        public int Id { get; set; }
        public string Namn { get; set; } = "";
        public string? Status { get; set; }
        public DateTime SkapadDatum { get; set; }
        public int AntalDelomraden { get; set; }
        public bool InventeringMojlig { get; set; }
    }

    private sealed class TraktStatistik
    {
        public int TraktId { get; set; }
        public string Namn { get; set; } = "";
        public int AntalDelomraden { get; set; }
        public double TotalAreal { get; set; }
        public double KlarAreal { get; set; }
        public double ProcentKlar { get; set; }
        public int AntalKlara { get; set; }
        public int TotaltAntalPlantor { get; set; }
        public List<DelOmradeAvvikelse> Avvikelser { get; set; } = new();
    }

    private sealed class DelOmradeAvvikelse
    {
        public int DelOmradeId { get; set; }
        public string Kommentar { get; set; } = "";
        public string Status { get; set; } = "";
    }

    private sealed class InventeringListItem
    {
        public int Id { get; set; }
        public int TraktId { get; set; }
        public string? TraktNamn { get; set; }
        public string? TilldeladAnvandare { get; set; }
        public InventeringStatus Status { get; set; }
        public int AntalProvytor { get; set; }
    }
}
