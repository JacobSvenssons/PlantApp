@page "/tidrapport"
@rendermode InteractiveServer
@using System.Globalization
@using System.Net.Http.Json
@using PlantApp.Dtos
@using PlantApp.Models
@using PlantApp.Services
@attribute [Authorize(Roles = "Plantsattare,Inventerare")]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<PageTitle>Hyggligt – Tidrapport</PageTitle>

<div class="tid-page">
    <div class="tid-card card-soft">
        <div class="tid-card__brand">
            <span class="tid-card__logo" aria-hidden="true">⏱️</span>
            <div>
                <h1 class="tid-card__titel">Tidrapport</h1>
                <p class="tid-card__subtitel">Rapportera dina timmar per vecka. Standard är helackord – välj timpenning för t.ex. hjälpplantering eller stenig mark.</p>
            </div>
        </div>

        @if (_error is not null)
        {
            <div class="tid-melding tid-melding--fel">@_error</div>
        }

        @if (_varning is not null)
        {
            <div class="tid-melding tid-melding--varning">
                <span>@_varning</span>
                <div class="tid-melding__knappar">
                    <button type="button" class="knapp-lank" @onclick="AvbrytVarning" disabled="@_sparar">Avbryt</button>
                    <button type="button" class="btn-pill btn-pill--liten" @onclick="SparaAnda" disabled="@_sparar">
                        @(_sparar ? "Sparar…" : "Spara ändå")
                    </button>
                </div>
            </div>
        }

        <div class="tid-vecka">
            <button type="button" class="tid-vecka__nav" @onclick="() => BytVecka(-1)" aria-label="Föregående vecka">
                <span class="tid-vecka__nav-ikon" aria-hidden="true">‹</span>
                <span class="tid-vecka__nav-text">Föregående</span>
            </button>
            <div class="tid-vecka__etikett">
                Vecka @IsoVecka(_veckoStart)
                <span class="tid-vecka__datum">@_veckoStart.ToString("d MMM", CultureInfo.CurrentCulture) – @_veckoStart.AddDays(6).ToString("d MMM", CultureInfo.CurrentCulture)</span>
            </div>
            <button type="button" class="tid-vecka__nav" @onclick="() => BytVecka(1)" aria-label="Nästa vecka">
                <span class="tid-vecka__nav-text">Nästa</span>
                <span class="tid-vecka__nav-ikon" aria-hidden="true">›</span>
            </button>
        </div>

        @if (_plantor is not null && (_plantor.TotaltAntalPlantor > 0 || _plantor.SasongAntalPlantor > 0))
        {
            <div class="tid-plantor">
                <div class="tid-plantor__topp">
                    <span class="tid-plantor__ikon" aria-hidden="true">🌲</span>
                    <div>
                        <span class="tid-plantor__label">Plantor satta denna vecka</span>
                        <span class="tid-plantor__total">@_plantor.TotaltAntalPlantor.ToString("#,0", CultureInfo.CurrentCulture) st</span>
                    </div>
                    <div class="tid-plantor__sasong">
                        <span class="tid-plantor__label">Säsongen @_plantor.SasongAr</span>
                        <span class="tid-plantor__total">@_plantor.SasongAntalPlantor.ToString("#,0", CultureInfo.CurrentCulture) st</span>
                    </div>
                </div>
                @if (_plantor.PerTrakt.Count > 0)
                {
                    <div class="tid-plantor__trakter">
                        @foreach (var t in _plantor.PerTrakt)
                        {
                            <span class="tid-chip">@t.TraktNamn: @t.AntalPlantor.ToString("#,0", CultureInfo.CurrentCulture) st</span>
                        }
                    </div>
                }
            </div>
        }

        <form class="tid-form" @onsubmit="LaggTill" @onsubmit:preventDefault="true">
            <div class="tid-form__falt">
                <label for="timmar">Timmar</label>
                <input id="timmar" type="number" min="0.5" step="0.5" class="tid-input"
                       @bind="_nyTimmar" />
            </div>
            <div class="tid-form__falt">
                <label for="typ">Ersättningsform</label>
                <select id="typ" class="tid-input" @bind="_nyTyp">
                    @foreach (var typ in AllaTyper)
                    {
                        <option value="@typ">@TypText(typ)</option>
                    }
                </select>
            </div>
            <div class="tid-form__falt">
                <label for="trakt">Trakt (valfritt)</label>
                <select id="trakt" class="tid-input" @bind="_nyTraktId">
                    <option value="">– Ingen –</option>
                    @if (_trakter is not null)
                    {
                        @foreach (var trakt in _trakter)
                        {
                            <option value="@trakt.Id">@trakt.Namn</option>
                        }
                    }
                </select>
            </div>
            <div class="tid-form__falt tid-form__falt--bred">
                <label for="kommentar">Kommentar (valfritt)</label>
                <input id="kommentar" type="text" class="tid-input" maxlength="1000"
                       placeholder="t.ex. hjälpplantering, stenig mark" @bind="_nyKommentar" />
            </div>
            <div class="tid-form__knapp">
                <button type="submit" class="btn-pill" disabled="@_sparar">
                    @(_sparar ? "Sparar…" : "Lägg till")
                </button>
            </div>
        </form>

        @if (_rader is null)
        {
            <div class="tid-melding">Laddar…</div>
        }
        else if (_rader.Count == 0)
        {
            <div class="tid-melding">Inga timmar rapporterade denna vecka ännu.</div>
        }
        else
        {
            <table class="tabell tid-tabell">
                <thead>
                    <tr>
                        <th class="tabell__num">Timmar</th>
                        <th>Ersättningsform</th>
                        <th>Trakt</th>
                        <th>Kommentar</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rad in _rader)
                    {
                        <tr>
                            <td class="tabell__num">@rad.AntalTimmar.ToString("0.##", CultureInfo.CurrentCulture)</td>
                            <td>@TypText(rad.ErsattningsTyp)</td>
                            <td>@(rad.TraktNamn ?? "–")</td>
                            <td>@(string.IsNullOrWhiteSpace(rad.Kommentar) ? "–" : rad.Kommentar)</td>
                            <td class="tabell__num">
                                <button type="button" class="knapp-lank" @onclick="() => TaBort(rad.Id)" disabled="@_sparar">
                                    Ta bort
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td class="tabell__num"><strong>@_rader.Sum(r => r.AntalTimmar).ToString("0.##", CultureInfo.CurrentCulture)</strong></td>
                        <td colspan="4">
                            @foreach (var grp in _rader.GroupBy(r => r.ErsattningsTyp).OrderBy(g => g.Key))
                            {
                                <span class="tid-chip">@TypText(grp.Key): @grp.Sum(r => r.AntalTimmar).ToString("0.##", CultureInfo.CurrentCulture) h</span>
                            }
                        </td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>

@code {
    private static readonly ErsattningsTyp[] AllaTyper = Enum.GetValues<ErsattningsTyp>();

    // Gräns för hur många timmar per vecka som anses "normalt" innan en varning visas.
    private const double VeckoTimGrans = 40;

    private List<TidrapportDto>? _rader;
    private List<TraktListItem>? _trakter;
    private PlantorVeckaDto? _plantor;
    private string? _error;
    private string? _varning;

    private string? _anvandare;
    private DateTime _veckoStart = MandagFor(DateTime.Today);

    private double _nyTimmar = 8;
    private ErsattningsTyp _nyTyp = ErsattningsTyp.HelAckord;
    private string? _nyTraktId;
    private string? _nyKommentar;
    private bool _sparar;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _anvandare = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                         ?? user.Identity?.Name;
        }

        await LaddaStandardTyp();
        await LaddaTrakter();
        await LaddaVecka();
    }

    private async Task LaddaStandardTyp()
    {
        try
        {
            var client = HttpClientFactory.CreateClient();
            var installning = await client.GetFromJsonAsync<EkonomiInstallningDto>(
                $"{NavigationManager.BaseUri}api/ekonomi/installning");
            if (installning is not null)
            {
                _nyTyp = installning.StandardErsattningsTyp;
            }
        }
        catch
        {
            // Standard förblir helackord om inställningen inte kan hämtas.
        }
    }

    private async Task LaddaTrakter()
    {
        try
        {
            var client = HttpClientFactory.CreateClient();
            _trakter = await client.GetFromJsonAsync<List<TraktListItem>>(
                $"{NavigationManager.BaseUri}api/trakt");
        }
        catch
        {
            _trakter = new();
        }
    }

    private async Task LaddaVecka()
    {
        if (string.IsNullOrWhiteSpace(_anvandare))
        {
            _error = "Kunde inte avgöra inloggad användare.";
            _rader = new();
            return;
        }

        _error = null;
        try
        {
            var client = HttpClientFactory.CreateClient();
            var url = $"{NavigationManager.BaseUri}api/tidrapport/mina" +
                      $"?anvandare={Uri.EscapeDataString(_anvandare)}&vecka={_veckoStart:yyyy-MM-dd}";
            _rader = await client.GetFromJsonAsync<List<TidrapportDto>>(url) ?? new();
        }
        catch (Exception ex)
        {
            _error = $"Kunde inte hämta tidrapporter: {ex.Message}";
            _rader = new();
        }

        await LaddaPlantor();
    }

    private async Task LaddaPlantor()
    {
        if (string.IsNullOrWhiteSpace(_anvandare))
        {
            _plantor = null;
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient();
            var url = $"{NavigationManager.BaseUri}api/trakt/plantor" +
                      $"?anvandare={Uri.EscapeDataString(_anvandare)}&vecka={_veckoStart:yyyy-MM-dd}";
            _plantor = await client.GetFromJsonAsync<PlantorVeckaDto>(url);
        }
        catch
        {
            // Plantsammanställningen är ett underlag – låt sidan fungera även om den fallerar.
            _plantor = null;
        }
    }

    private async Task BytVecka(int riktning)
    {
        _varning = null;
        _veckoStart = _veckoStart.AddDays(7 * riktning);
        await LaddaVecka();
    }

    private async Task LaggTill()
    {
        if (_sparar || string.IsNullOrWhiteSpace(_anvandare))
        {
            return;
        }

        if (_nyTimmar <= 0)
        {
            _error = "Antal timmar måste vara större än 0.";
            return;
        }

        _error = null;

        // Varna om veckans totala timmar (befintliga + de nya) överstiger gränsen.
        var totalEfter = (_rader?.Sum(r => r.AntalTimmar) ?? 0) + _nyTimmar;
        if (_varning is null && totalEfter > VeckoTimGrans)
        {
            _varning = $"Veckan får då {totalEfter.ToString("0.##", CultureInfo.CurrentCulture)} h " +
                       $"totalt, vilket är mer än {VeckoTimGrans:0} h. Vill du spara ändå?";
            return;
        }

        await SparaRadAsync();
    }

    private async Task SparaAnda()
    {
        _varning = null;
        await SparaRadAsync();
    }

    private void AvbrytVarning()
    {
        _varning = null;
    }

    private async Task SparaRadAsync()
    {
        if (_sparar || string.IsNullOrWhiteSpace(_anvandare))
        {
            return;
        }

        _sparar = true;
        _error = null;
        _varning = null;

        try
        {
            int? traktId = int.TryParse(_nyTraktId, out var id) ? id : null;
            var dto = new TidrapportInputDto
            {
                VeckoStart = _veckoStart,
                AntalTimmar = _nyTimmar,
                ErsattningsTyp = _nyTyp,
                TraktId = traktId,
                Kommentar = _nyKommentar
            };

            var client = HttpClientFactory.CreateClient();
            var response = await client.PostAsJsonAsync(
                $"{NavigationManager.BaseUri}api/tidrapport?anvandare={Uri.EscapeDataString(_anvandare)}",
                dto);

            if (response.IsSuccessStatusCode)
            {
                // Nollställ formuläret så nästa rad börjar från ett tomt läge.
                _nyTimmar = 0;
                _nyKommentar = null;
                await LaddaVecka();
            }
            else
            {
                _error = $"Kunde inte spara (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _error = $"Fel vid sparande: {ex.Message}";
        }
        finally
        {
            _sparar = false;
        }
    }

    private async Task TaBort(int id)
    {
        if (_sparar || string.IsNullOrWhiteSpace(_anvandare))
        {
            return;
        }

        _sparar = true;
        _error = null;

        try
        {
            var client = HttpClientFactory.CreateClient();
            var response = await client.DeleteAsync(
                $"{NavigationManager.BaseUri}api/tidrapport/{id}?anvandare={Uri.EscapeDataString(_anvandare)}");

            if (response.IsSuccessStatusCode)
            {
                await LaddaVecka();
            }
            else
            {
                _error = $"Kunde inte ta bort (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _error = $"Fel vid borttagning: {ex.Message}";
        }
        finally
        {
            _sparar = false;
        }
    }

    private static DateTime MandagFor(DateTime datum)
    {
        int diff = (7 + (int)datum.DayOfWeek - (int)DayOfWeek.Monday) % 7;
        return datum.Date.AddDays(-diff);
    }

    private static int IsoVecka(DateTime datum) =>
        System.Globalization.ISOWeek.GetWeekOfYear(datum);

    private static string TypText(ErsattningsTyp typ) => typ switch
    {
        ErsattningsTyp.HelAckord => "Helackord",
        ErsattningsTyp.DelAckord => "Delackord",
        ErsattningsTyp.Timpenning => "Timpenning",
        _ => typ.ToString()
    };

    private sealed class TraktListItem
    {
        public int Id { get; set; }
        public string Namn { get; set; } = "";
    }
}
