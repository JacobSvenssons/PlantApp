@page "/trakt/{TraktId:int}"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using PlantApp.Dtos
@using PlantApp.Models
@using PlantApp.Services
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject DemoUserStore DemoUserStore
@implements IAsyncDisposable

<PageTitle>Trakt @TraktId</PageTitle>

<div class="trakt-karta-page">
	<div id="trakt-karta" class="trakt-karta"></div>

	@if (_kanAndraTradsort || _kanAndraMal)
	{
		<div class="trakt-toolbar">
			@if (_kanAndraTradsort)
			{
				<label class="trakt-toolbar__label" for="trakt-standard-tradsort">Traktens trädsort</label>
				<select id="trakt-standard-tradsort" class="trakt-toolbar__select"
						value="@(_traktStandardTradsort ?? "")" @onchange="OnTraktTradsortChanged" disabled="@_sparTraktTradsort">
					<option value="">– Ingen standard –</option>
					@foreach (var sort in Tradsorter.Standard)
					{
						<option value="@sort">@sort</option>
					}
				</select>
				@if (_sparTraktTradsort)
				{
					<span class="trakt-toolbar__status">Sparar…</span>
				}
			}
			@if (_kanAndraMal)
			{
				<label class="trakt-toolbar__label" for="trakt-mal">Mål plantor/ha</label>
				<input id="trakt-mal" type="number" min="0" class="trakt-toolbar__input"
					   value="@(_traktMalPlantorPerHektar?.ToString() ?? "")"
					   @onchange="OnTraktMalChanged" disabled="@_sparTraktMal" />
				@if (_sparTraktMal)
				{
					<span class="trakt-toolbar__status">Sparar…</span>
				}
			}
		</div>
	}

	@if (_isAdmin && _mapReady)
	{
		<div class="trakt-provyta-export">
			<button type="button" class="trakt-provyta-export__knapp" @onclick="LaddaNerProvytorAsync"
					title="Ladda ner traktens provytor med kartmarkeringar som GeoJSON">
				⬇ Ladda ner provytor (GeoJSON)
			</button>
		</div>
	}

	@if (_kanSeAvvikelser && _mapReady)
	{
		<div class="avvikelse-panel @(_visaAvvikelser ? "avvikelse-panel--oppen" : null)">
			<button type="button" class="avvikelse-panel__knapp" @onclick="ToggleAvvikelser"
					aria-expanded="@_visaAvvikelser">
				<span class="avvikelse-panel__ikon" aria-hidden="true">⚠️</span>
				<span class="avvikelse-panel__titel">Avvikelser</span>
				<span class="avvikelse-panel__antal">@_avvikelser.Count</span>
			</button>

			@if (_visaAvvikelser)
			{
				<div class="avvikelse-panel__kropp">
					@if (_avvikelser.Count == 0)
					{
						<div class="avvikelse-panel__tom">Inga avvikelser noterade på trakten.</div>
					}
					else
					{
						<ul class="avvikelse-panel__lista">
							@foreach (var avvikelse in _avvikelser)
							{
								<li>
									<button type="button" class="avvikelse-panel__rad" @onclick="() => FocusAvvikelse(avvikelse.DelOmradeId)">
										<span class="avvikelse-panel__ruta">Delområde #@avvikelse.DelOmradeId</span>
										<span class="avvikelse-panel__text">@avvikelse.Kommentar</span>
									</button>
								</li>
							}
						</ul>
					}
				</div>
			}
		</div>
	}

	@if (_loadError is not null)
	{
		<div class="karta-status karta-status--fel">@_loadError</div>
	}
	else if (!_mapReady)
	{
		<div class="karta-status">Laddar karta…</div>
	}

	@if (_toastMessage is not null)
	{
		<div class="karta-toast">@_toastMessage</div>
	}

	@if (_markeringIndex is not null)
	{
		<div class="markering-banner">
			<span class="markering-banner__text">Klicka i kartan för att markera plats för provyta #@(_markeringIndex + 1).</span>
			<button type="button" class="markering-banner__avbryt" @onclick="AvbrytMarkering">Avbryt</button>
		</div>
	}

	@if (_selected is not null)
	{
		<div class="rapport-panel @(_markeringIndex is not null ? "rapport-panel--dold" : null)" role="dialog" aria-modal="false" aria-label="Rapportera delområde">
			<div class="rapport-panel__header">
				<div>
					<h2 class="rapport-panel__titel">Delområde #@_selected.Id</h2>
					<span class="rapport-panel__subtitel">Trakt @_selected.TraktId</span>
				</div>
				<button type="button" class="rapport-panel__stang" title="Stäng" @onclick="ClosePanel">&times;</button>
			</div>

			@if (!KanRedigeraRuta)
			{
				<div class="rapport-panel__las">
					🔒 Rutan är tilldelad @DemoUserStore.GetDisplayName(_tilldeladAnvandare) och kan bara ändras av den plantören.
				</div>
			}

			<div class="rapport-panel__grid">
				<div class="falt">
					<label>Areal</label>
					<div class="falt__varde">@_selected.Areal.ToString("0.##") ha</div>
				</div>
				<div class="falt">
					<label for="ruta-tradsort">Trädsort</label>
					@if (_kanAndraTradsort)
					{
						<select id="ruta-tradsort" class="falt__input" @bind="_tradsort">
							<option value="">
								@(string.IsNullOrWhiteSpace(_traktStandardTradsort)
									? "– Ej angiven –"
									: $"Traktens standard ({_traktStandardTradsort})")
							</option>
							@foreach (var sort in Tradsorter.Standard)
							{
								<option value="@sort">@sort</option>
							}
						</select>
					}
					else
					{
						<div class="falt__varde">
							@(string.IsNullOrWhiteSpace(_tradsort)
								? (string.IsNullOrWhiteSpace(_traktStandardTradsort)
									? "– Ej angiven –"
									: $"{_traktStandardTradsort} (traktens standard)")
								: _tradsort)
						</div>
					}
				</div>
			</div>

			<div class="falt">
				<label>Status</label>
				<div class="status-checklista">
					<label class="checklista-rad">
						<input type="checkbox" checked="@_paborjad" @onchange="OnPaborjadChanged" disabled="@(!KanRedigeraRuta)" />
						<span class="checklista-rad__prick checklista-rad__prick--paborjad"></span>
						<span class="checklista-rad__text">Påbörja område</span>
					</label>
					<label class="checklista-rad">
						<input type="checkbox" checked="@_klar" @onchange="OnKlarChanged" disabled="@(!KanRedigeraRuta)" />
						<span class="checklista-rad__prick checklista-rad__prick--klar"></span>
						<span class="checklista-rad__text">Markera som klar</span>
					</label>
				</div>
			</div>

			<div class="rapport-panel__grid">
				<div class="falt">
					<label for="antal-plantor">Antal plantor</label>
					<input id="antal-plantor" type="number" min="0" class="falt__input"
						   @bind="_antalPlantor" @bind:event="oninput" disabled="@(!KanRedigeraRuta)" />
				</div>
				<div class="falt">
					<label for="ruta-mal">Mål plantor/ha</label>
					@if (_kanAndraMal)
					{
						<input id="ruta-mal" type="number" min="0" class="falt__input"
							   placeholder="@(_traktMalPlantorPerHektar is not null ? $"Traktens mål ({_traktMalPlantorPerHektar})" : "– Ej angivet –")"
							   @bind="_malPlantorPerHektar" />
					}
					else
					{
						<div class="falt__varde">
							@(_malPlantorPerHektar is not null
								? _malPlantorPerHektar.ToString()
								: (_traktMalPlantorPerHektar is not null
									? $"{_traktMalPlantorPerHektar} (traktens mål)"
									: "– Ej angivet –"))
						</div>
					}
				</div>
			</div>

			@if (_kanTilldela)
			{
				<div class="falt">
					<label for="tilldelad-anvandare">Tilldelad</label>
					<select id="tilldelad-anvandare" class="falt__input" @bind="_tilldeladAnvandare">
						<option value="">– Ingen –</option>
						@foreach (var user in _appointableUsers)
						{
							<option value="@user.UserName">@user.DisplayName (@user.Role)</option>
						}
					</select>
				</div>
			}
			else if (!string.IsNullOrWhiteSpace(_tilldeladAnvandare))
			{
				<div class="falt">
					<label>Tilldelad</label>
					<div class="falt__varde">@DemoUserStore.GetDisplayName(_tilldeladAnvandare)</div>
				</div>
			}

			<div class="falt">
				<label for="ruta-kommentar">Avvikelse / kommentar</label>
				<textarea id="ruta-kommentar" class="falt__input falt__textarea" rows="3"
						  placeholder="Notera t.ex. hinder i terrängen eller avvikelser"
						  @bind="_kommentar" disabled="@(!KanRedigeraRuta)"></textarea>
			</div>

			<div class="falt">
				<div class="provytor__rubrik">
					<label>Provytor (@_provytor.Count)</label>
					<button type="button" class="knapp knapp--lank" @onclick="AddProvyta" disabled="@(!KanRedigeraRuta)">+ Lägg till provyta</button>
				</div>

				@if (_provytor.Count == 0)
				{
					<div class="provytor__tom">Inga provytor registrerade.</div>
				}
				else
				{
					<div class="provytor">
						@for (var i = 0; i < _provytor.Count; i++)
						{
							var index = i;
							var provyta = _provytor[index];
							<div class="provyta-rad">
								<span class="provyta-rad__nr">#@(index + 1)</span>
								<input type="number" min="0" class="falt__input provyta-rad__input"
									   placeholder="Antal plantor"
									   value="@provyta.Antal"
									   @onchange="e => OnProvytaChanged(index, e)" />
								<button type="button"
										class="provyta-rad__markera @(provyta.HarPlats ? "provyta-rad__markera--satt" : null) @(_markeringIndex == index ? "provyta-rad__markera--aktiv" : null)"
										title="@(provyta.HarPlats ? "Provytan är markerad på kartan – klicka för att flytta" : "Markera provytans plats på kartan")"
										@onclick="() => StartMarkering(index)">
									@(_markeringIndex == index ? "Klicka i kartan…" : provyta.HarPlats ? "📍 Markerad" : "📍 Markera")
								</button>
								@if (provyta.HarPlats)
								{
									<button type="button" class="provyta-rad__rensa-plats" title="Ta bort markering"
											@onclick="() => ClearMarkering(index)">Rensa plats</button>
								}
								<button type="button" class="provyta-rad__ta-bort" title="Ta bort provyta"
										@onclick="() => RemoveProvyta(index)">&times;</button>
							</div>
						}
					</div>
				}
			</div>

			@if (_saveMessage is not null)
			{
				<div class="rapport-panel__meddelande @(_saveError ? "rapport-panel__meddelande--fel" : "rapport-panel__meddelande--ok")">
					@_saveMessage
				</div>
			}

			<div class="rapport-panel__actions">
				<button type="button" class="knapp knapp--sekundar" @onclick="ClosePanel" disabled="@_saving">Avbryt</button>
				<button type="button" class="knapp knapp--primar" @onclick="SaveAsync" disabled="@(_saving || !KanRedigeraRuta)">
					@(_saving ? "Sparar…" : "Spara")
				</button>
			</div>
		</div>
	}
</div>

@code {
	[Parameter]
	public int TraktId { get; set; }

	[CascadingParameter]
	private Task<AuthenticationState>? AuthState { get; set; }

	private IJSObjectReference? _module;
	private DotNetObjectReference<TraktKarta>? _selfRef;

	private bool _mapReady;
	private string? _loadError;

	private FeatureProperties? _selected;
	private bool _paborjad;
	private bool _klar;
	private int? _antalPlantor;
	private string? _tradsort;
	private int? _malPlantorPerHektar;
	private string? _kommentar;
	private string? _tilldeladAnvandare;
	private readonly List<ProvytaEntry> _provytor = new();

	// Index för den provyta vars plats användaren håller på att markera på kartan.
	// Null när ingen markering pågår.
	private int? _markeringIndex;

	private bool _saving;
	private bool _saveError;
	private string? _saveMessage;

	private string? _toastMessage;
	private CancellationTokenSource? _toastCts;

	// Roll- och trakt-nivå-tillstånd.
	private bool _isAdmin;
	private bool _isPlantsattare;
	private string? _currentUser;
	private bool _kanTilldela;
	private bool _kanAndraTradsort;
	private bool _kanAndraMal;
	private bool _kanSeAvvikelser;
	private IReadOnlyList<DemoUserStore.DemoUser> _appointableUsers = [];
	private string? _traktStandardTradsort;
	private bool _sparTraktTradsort;
	private int? _traktMalPlantorPerHektar;
	private bool _sparTraktMal;

	// Avvikelser/kommentarer på trakten (sammanfattning för admin/plantbas).
	private List<DelOmradeAvvikelseDto> _avvikelser = new();
	private bool _visaAvvikelser;

	protected override async Task OnInitializedAsync()
	{
		_appointableUsers = DemoUserStore.GetAppointableUsers();

		if (AuthState is not null)
		{
			var user = (await AuthState).User;
			_isAdmin = user.IsInRole(DemoUserStore.RoleAdmin);
			_isPlantsattare = user.IsInRole(DemoUserStore.RolePlantsattare);
			_currentUser = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
			// Admin och plantbas får tilldela rutor till fältpersonal.
			_kanTilldela = _isAdmin || user.IsInRole(DemoUserStore.RolePlantbas);
			// Trädslag sätts av admin/plantbas; plantsättare ser det bara.
			_kanAndraTradsort = _isAdmin || user.IsInRole(DemoUserStore.RolePlantbas);
			// Mål plantor/ha sätts av admin/plantbas; plantsättare ser det bara.
			_kanAndraMal = _isAdmin || user.IsInRole(DemoUserStore.RolePlantbas);
			// Avvikelse-sammanfattningen är ett översiktsverktyg för admin/plantbas.
			_kanSeAvvikelser = _isAdmin || user.IsInRole(DemoUserStore.RolePlantbas);
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
		{
			return;
		}

		try
		{
			_module = await JS.InvokeAsync<IJSObjectReference>(
				"import", "./Components/Pages/TraktKarta.razor.js");
			_selfRef = DotNetObjectReference.Create(this);

			// Hämta GeoJSON (WGS84) från vårt eget API via HttpClient.
			var client = HttpClientFactory.CreateClient();
			var geoJson = await client.GetStringAsync(
				$"{NavigationManager.BaseUri}api/trakt/{TraktId}/geojson");

			await _module.InvokeVoidAsync("initMap", "trakt-karta", geoJson, _selfRef);

			// Rita ut redan registrerade provyta-markeringar på kartan.
			await ReloadProvytorLayerAsync(client);

			// Hämta traktens standardträdsort (visas som förval i panelen och i admin-toolbaren).
			try
			{
				var tradsort = await client.GetFromJsonAsync<TraktTradsortDto>(
					$"{NavigationManager.BaseUri}api/trakt/{TraktId}/tradsort");
				_traktStandardTradsort = tradsort?.StandardTradsort;
			}
			catch
			{
				// Trakt-standarden är inte kritisk för att kartan ska fungera.
			}

			// Hämta traktens mål plantor/ha (visas som förval i panelen och i admin-toolbaren).
			try
			{
				var mal = await client.GetFromJsonAsync<TraktMalDto>(
					$"{NavigationManager.BaseUri}api/trakt/{TraktId}/mal");
				_traktMalPlantorPerHektar = mal?.MalPlantorPerHektar;
			}
			catch
			{
				// Trakt-målet är inte kritiskt för att kartan ska fungera.
			}

			// Hämta avvikelser för sammanfattningen (endast admin/plantbas).
			if (_kanSeAvvikelser)
			{
				await LoadAvvikelserAsync(client);
			}

			_mapReady = true;
		}
		catch (Exception ex)
		{
			_loadError = $"Kunde inte ladda kartan: {ex.Message}";
		}

		StateHasChanged();
	}

	/// <summary>
	/// Anropas från JavaScript när användaren klickar på en ruta i kartan.
	/// </summary>
	[JSInvokable]
	public async Task OnFeatureClicked(FeatureProperties properties)
	{
		_selected = properties;

		var status = Enum.TryParse<DelOmradeStatus>(properties.Status, ignoreCase: true, out var parsed)
			? parsed
			: DelOmradeStatus.EjPaborjad;
		_klar = status == DelOmradeStatus.Klar;
		_paborjad = status is DelOmradeStatus.Paborjad or DelOmradeStatus.Klar;

		_antalPlantor = properties.AntalPlantor;
		_tradsort = null;
		_malPlantorPerHektar = null;
		_kommentar = null;
		_tilldeladAnvandare = null;
		_provytor.Clear();
		_markeringIndex = null;
		_saveMessage = null;
		_saveError = false;

		// Visa panelen direkt, hämta sedan provytorna från detalj-endpointen.
		await InvokeAsync(StateHasChanged);

		if (properties.Id <= 0)
		{
			return;
		}

		try
		{
			var client = HttpClientFactory.CreateClient();
			var detail = await client.GetFromJsonAsync<DelOmradeDetailDto>(
				$"{NavigationManager.BaseUri}api/trakt/delomrade/{properties.Id}");

			// Ignorera om användaren hunnit klicka på en annan ruta under tiden.
			if (detail is not null && _selected?.Id == properties.Id)
			{
				_tradsort = detail.Tradsort;
				_malPlantorPerHektar = detail.MalPlantorPerHektar;
				_kommentar = detail.Kommentar;
				_tilldeladAnvandare = detail.TilldeladAnvandare;
				// Håll trakt-standarden aktuell (kan ha ändrats via admin-toolbaren).
				_traktStandardTradsort = detail.TraktStandardTradsort;
				_traktMalPlantorPerHektar = detail.TraktMalPlantorPerHektar;
				_provytor.Clear();
				_provytor.AddRange(detail.Provytor.Select(p => new ProvytaEntry
				{
					Antal = p.AntalPlantor,
					Latitud = p.Latitud,
					Longitud = p.Longitud
				}));
				await InvokeAsync(StateHasChanged);
			}
		}
		catch
		{
			// Provytor är inte kritiska för att panelen ska fungera – ignorera hämtningsfel.
		}
	}

	// Kryssrutornas kaskadlogik: "Klar" förutsätter "Påbörjad".
	private void OnPaborjadChanged(ChangeEventArgs e)
	{
		_paborjad = (bool)(e.Value ?? false);
		if (!_paborjad)
		{
			// Bockar man ur "Påbörjad" kan området inte vara "Klart".
			_klar = false;

			// När en plantsättare ångrar sin egen påbörjade ruta släpps tilldelningen
			// så att rutan låses upp och kan "tas" av en annan plantör.
			if (_isPlantsattare
				&& !string.IsNullOrWhiteSpace(_tilldeladAnvandare)
				&& string.Equals(_tilldeladAnvandare, _currentUser, StringComparison.OrdinalIgnoreCase))
			{
				_tilldeladAnvandare = null;
			}
		}
		else if (_isPlantsattare && string.IsNullOrWhiteSpace(_tilldeladAnvandare)
				 && !string.IsNullOrWhiteSpace(_currentUser))
		{
			// När en plantsättare påbörjar en oanvänd ruta tilldelas den automatiskt
			// den inloggade användaren.
			_tilldeladAnvandare = _currentUser;
		}
	}

	private void OnKlarChanged(ChangeEventArgs e)
	{
		_klar = (bool)(e.Value ?? false);
		if (_klar)
		{
			// "Klar" innebär automatiskt "Påbörjad".
			_paborjad = true;
			if (_isPlantsattare && string.IsNullOrWhiteSpace(_tilldeladAnvandare)
				&& !string.IsNullOrWhiteSpace(_currentUser))
			{
				_tilldeladAnvandare = _currentUser;
			}
		}
	}

	private DelOmradeStatus CurrentStatus =>
		_klar ? DelOmradeStatus.Klar
		: _paborjad ? DelOmradeStatus.Paborjad
		: DelOmradeStatus.EjPaborjad;

	// Sant om rutan är tilldelad en annan plantsättare än den inloggade.
	// Används för att låsa/hindra att man ändrar på någon annans ruta.
	private bool AgsAvAnnan =>
		!string.IsNullOrWhiteSpace(_tilldeladAnvandare)
		&& !string.Equals(_tilldeladAnvandare, _currentUser, StringComparison.OrdinalIgnoreCase);

	// Plantsättare får bara redigera rutor som inte tillhör någon annan plantsättare.
	// Admin/plantbas (de som får tilldela) har alltid redigeringsrätt.
	private bool KanRedigeraRuta => _kanTilldela || !(_isPlantsattare && AgsAvAnnan);

	// Sätter traktens standardträdsort (admin-toolbaren). Sparas direkt mot API:t.
	private async Task OnTraktTradsortChanged(ChangeEventArgs e)
	{
		var value = e.Value?.ToString();
		var nyStandard = string.IsNullOrWhiteSpace(value) ? null : value;

		_sparTraktTradsort = true;
		try
		{
			var client = HttpClientFactory.CreateClient();
			var response = await client.PutAsJsonAsync(
				$"{NavigationManager.BaseUri}api/trakt/{TraktId}/tradsort",
				new TraktTradsortDto { StandardTradsort = nyStandard });

			if (response.IsSuccessStatusCode)
			{
				_traktStandardTradsort = nyStandard;
				ShowToast("Traktens trädsort sparad.");
			}
			else
			{
				ShowToast($"Kunde inte spara trädsort (HTTP {(int)response.StatusCode}).");
			}
		}
		catch (Exception ex)
		{
			ShowToast($"Fel vid sparande av trädsort: {ex.Message}");
		}
		finally
		{
			_sparTraktTradsort = false;
		}
	}

	// Sätter traktens mål plantor/ha (admin-toolbaren). Sparas direkt mot API:t.
	private async Task OnTraktMalChanged(ChangeEventArgs e)
	{
		var value = e.Value?.ToString();
		int? nyttMal = int.TryParse(value, out var parsed) && parsed > 0 ? parsed : null;

		_sparTraktMal = true;
		try
		{
			var client = HttpClientFactory.CreateClient();
			var response = await client.PutAsJsonAsync(
				$"{NavigationManager.BaseUri}api/trakt/{TraktId}/mal",
				new TraktMalDto { MalPlantorPerHektar = nyttMal });

			if (response.IsSuccessStatusCode)
			{
				_traktMalPlantorPerHektar = nyttMal;
				ShowToast("Traktens mål plantor/ha sparat.");
			}
			else
			{
				ShowToast($"Kunde inte spara mål (HTTP {(int)response.StatusCode}).");
			}
		}
		catch (Exception ex)
		{
			ShowToast($"Fel vid sparande av mål: {ex.Message}");
		}
		finally
		{
			_sparTraktMal = false;
		}
	}

	// Hämtar trakten statistik och plockar ut avvikelserna för sammanfattningen.
	private async Task LoadAvvikelserAsync(HttpClient client)
	{
		try
		{
			var statistik = await client.GetFromJsonAsync<TraktStatistikDto>(
				$"{NavigationManager.BaseUri}api/trakt/{TraktId}/statistik");
			_avvikelser = statistik?.Avvikelser ?? new();
		}
		catch
		{
			// Avvikelse-sammanfattningen är inte kritisk för att kartan ska fungera.
		}
	}

	private void ToggleAvvikelser()
	{
		_visaAvvikelser = !_visaAvvikelser;
	}

	// Flyger till rutan på kartan och öppnar dess panel när en avvikelse klickas.
	private async Task FocusAvvikelse(int delOmradeId)
	{
		if (_module is null)
		{
			return;
		}

		// Fäll ihop panelen så att den inte skymmer rutan man hoppar till.
		_visaAvvikelser = false;

		try
		{
			await _module.InvokeVoidAsync("focusFeature", delOmradeId);
		}
		catch
		{
			// Om rutan inte kan hittas i kartan är det inte kritiskt – ignorera.
		}
	}

	private void AddProvyta()
	{
		_provytor.Add(new ProvytaEntry());
	}

	private async Task RemoveProvyta(int index)
	{
		if (index >= 0 && index < _provytor.Count)
		{
			_provytor.RemoveAt(index);

			// Avbryt ev. pågående markering och rensa temporära markörer så att de
			// inte hamnar i otakt med listan.
			_markeringIndex = null;
			await RefreshTempMarkorerAsync();
		}
	}

	private void OnProvytaChanged(int index, ChangeEventArgs e)
	{
		if (index < 0 || index >= _provytor.Count)
		{
			return;
		}

		_provytor[index].Antal = int.TryParse(e.Value?.ToString(), out var antal) && antal >= 0
			? antal
			: null;
	}

	// Startar markeringsläge för en provyta: nästa klick i kartan sätter provytans plats.
	private async Task StartMarkering(int index)
	{
		if (index < 0 || index >= _provytor.Count || _module is null)
		{
			return;
		}

		_markeringIndex = index;
		ShowToast("Klicka i kartan för att markera provytans plats.");

		try
		{
			await _module.InvokeVoidAsync("startPointPicking");
		}
		catch
		{
			// Om kartan inte är redo är markeringen inte kritisk – ignorera.
		}
	}

	// Avbryter pågående markering utan att sätta någon plats.
	private async Task AvbrytMarkering()
	{
		_markeringIndex = null;

		if (_module is not null)
		{
			try
			{
				await _module.InvokeVoidAsync("cancelPointPicking");
			}
			catch
			{
				// Icke-kritiskt om kartan inte kan avbryta markeringsläget.
			}
		}
	}

	// Tar bort en provytas markering (men behåller provytan).
	private async Task ClearMarkering(int index)
	{
		if (index < 0 || index >= _provytor.Count)
		{
			return;
		}

		_provytor[index].Latitud = null;
		_provytor[index].Longitud = null;
		await RefreshTempMarkorerAsync();
	}

	/// <summary>
	/// Anropas från JavaScript när användaren klickat i kartan i markeringsläge.
	/// Sätter den aktiva provytans plats (WGS84) och ritar om de temporära markörerna.
	/// </summary>
	[JSInvokable]
	public async Task OnMapPointPicked(double latitud, double longitud)
	{
		if (_markeringIndex is not { } index || index < 0 || index >= _provytor.Count)
		{
			_markeringIndex = null;
			return;
		}

		_provytor[index].Latitud = latitud;
		_provytor[index].Longitud = longitud;
		_markeringIndex = null;

		await RefreshTempMarkorerAsync();
		await InvokeAsync(StateHasChanged);
		ShowToast("Provytans plats markerad.");
	}

	// Ritar om de temporära markörerna för provytorna i den öppna panelen.
	private async Task RefreshTempMarkorerAsync()
	{
		if (_module is null)
		{
			return;
		}

		var punkter = _provytor
			.Select((p, i) => new { index = i, lat = p.Latitud, lng = p.Longitud })
			.Where(p => p.lat is not null && p.lng is not null)
			.Select(p => new { p.index, lat = p.lat!.Value, lng = p.lng!.Value })
			.ToArray();

		try
		{
			await _module.InvokeVoidAsync("setTempProvytaMarkorer", punkter);
		}
		catch
		{
			// Icke-kritiskt om kartan inte kan uppdatera markörerna.
		}
	}

	// Laddar ner traktens karta med markerade provytor som GeoJSON (admin-funktion).
	private async Task LaddaNerProvytorAsync()
	{
		if (_module is null)
		{
			return;
		}

		try
		{
			await _module.InvokeVoidAsync("downloadProvytorGeoJson", TraktId);
			ShowToast("Provytor exporterade som GeoJSON.");
		}
		catch (Exception ex)
		{
			ShowToast($"Kunde inte ladda ner provytor: {ex.Message}");
		}
	}

	// Hämtar traktens sparade provytor (GeoJSON) och ritar ut dem som markörer.
	private async Task ReloadProvytorLayerAsync(HttpClient client)
	{
		if (_module is null)
		{
			return;
		}

		try
		{
			var provytorGeoJson = await client.GetStringAsync(
				$"{NavigationManager.BaseUri}api/trakt/{TraktId}/provytor/geojson");
			await _module.InvokeVoidAsync("setProvytaLager", provytorGeoJson);
		}
		catch
		{
			// Provyta-markörerna är inte kritiska för att kartan ska fungera.
		}
	}

	private async Task SaveAsync()
	{
		if (_selected is null)
		{
			return;
		}

		if (_selected.Id <= 0)
		{
			_saveError = true;
			_saveMessage = "Kunde inte spara: delområdet saknar giltigt id.";
			return;
		}

		if (!KanRedigeraRuta)
		{
			_saveError = true;
			_saveMessage = "Rutan är tilldelad en annan plantör och kan inte ändras.";
			return;
		}

		var status = CurrentStatus;

		// Ett delområde kan inte markeras som klart utan att antal plantor är angivet.
		if (status == DelOmradeStatus.Klar && (_antalPlantor is null or <= 0))
		{
			_saveError = true;
			_saveMessage = "Ange antal plantor innan området markeras som klart.";
			return;
		}

		_saving = true;
		_saveMessage = null;
		_saveError = false;

		try
		{
			var dto = new DelOmradeUpdateDto
			{
				Status = status,
				AntalPlantor = _antalPlantor,
				Tradsort = _tradsort,
				MalPlantorPerHektar = _malPlantorPerHektar,
				Kommentar = _kommentar,
				TilldeladAnvandare = _tilldeladAnvandare,
				Provytor = _provytor.Select(p => new ProvytaInputDto
				{
					AntalPlantor = p.Antal ?? 0,
					Latitud = p.Latitud,
					Longitud = p.Longitud
				}).ToList()
			};

			var client = HttpClientFactory.CreateClient();
			var response = await client.PutAsJsonAsync(
				$"{NavigationManager.BaseUri}api/trakt/delomrade/{_selected.Id}", dto);

			if (response.IsSuccessStatusCode)
			{
				if (_module is not null)
				{
					// Färglägg om rutan direkt utifrån ny status och uppdatera det
					// cachade plantantalet så att ett nytt klick visar rätt värde.
					await _module.InvokeVoidAsync("updateFeatureStatus", _selected.Id, (int)status, _antalPlantor);
				}

				// Stäng panelen så att den inte längre ligger kvar ovanpå kartan och
				// blockerar klick (den täckte annars ofta just den ruta man redigerat,
				// eftersom panelen glider upp från botten av kartvyn). Visa i stället
				// en kort, självförsvinnande bekräftelse.
				_selected = null;
				ShowToast("Sparat.");

				// Rensa temporära provyta-markörer och ladda om det sparade lagret.
				_markeringIndex = null;
				if (_module is not null)
				{
					await _module.InvokeVoidAsync("setTempProvytaMarkorer", Array.Empty<object>());
					await ReloadProvytorLayerAsync(client);
				}

				// Håll avvikelse-sammanfattningen aktuell (kommentaren kan ha ändrats).
				if (_kanSeAvvikelser)
				{
					await LoadAvvikelserAsync(client);
				}
			}
			else
			{
				_saveError = true;
				_saveMessage = $"Kunde inte spara (HTTP {(int)response.StatusCode}).";
			}
		}
		catch (Exception ex)
		{
			_saveError = true;
			_saveMessage = $"Fel vid sparande: {ex.Message}";
		}
		finally
		{
			_saving = false;
		}
	}

	private void ClosePanel()
	{
		_selected = null;
		_saveMessage = null;
		_saveError = false;
		_markeringIndex = null;

		// Avbryt ev. pågående markering och rensa temporära markörer.
		if (_module is not null)
		{
			_ = _module.InvokeVoidAsync("cancelPointPicking");
			_ = _module.InvokeVoidAsync("setTempProvytaMarkorer", Array.Empty<object>());
		}
	}

	// Visar ett kort, självförsvinnande meddelande överst på kartan (t.ex. efter sparning).
	private void ShowToast(string message)
	{
		_toastCts?.Cancel();
		var cts = new CancellationTokenSource();
		_toastCts = cts;
		_toastMessage = message;

		_ = HideToastAfterDelayAsync(cts.Token);
	}

	private async Task HideToastAfterDelayAsync(CancellationToken cancellationToken)
	{
		try
		{
			await Task.Delay(TimeSpan.FromSeconds(2.5), cancellationToken);
		}
		catch (TaskCanceledException)
		{
			return;
		}

		if (cancellationToken.IsCancellationRequested)
		{
			return;
		}

		_toastMessage = null;

		try
		{
			await InvokeAsync(StateHasChanged);
		}
		catch (ObjectDisposedException)
		{
			// Komponenten har hunnit kopplas ned – inget att uppdatera.
		}
	}

	public async ValueTask DisposeAsync()
	{
		_toastCts?.Cancel();

		try
		{
			if (_module is not null)
			{
				await _module.InvokeVoidAsync("dispose", "trakt-karta");
				await _module.DisposeAsync();
			}
		}
		catch (JSDisconnectedException)
		{
			// Kretsen är redan nedkopplad – inget att städa.
		}

		_selfRef?.Dispose();
	}

	/// <summary>
	/// Egenskaper som skickas från kartans klickhändelse (matchar GeoJSON-propertyn).
	/// </summary>
	public class FeatureProperties
	{
		public int Id { get; set; }
		public int TraktId { get; set; }
		public string? Status { get; set; }
		public double Areal { get; set; }
		public string? Tradsort { get; set; }
		public int? AntalPlantor { get; set; }
	}

	/// <summary>
	/// En provyta i rapporteringspanelen: antal plantor och en valfri kartmarkering (WGS84).
	/// </summary>
	private sealed class ProvytaEntry
	{
		public int? Antal { get; set; }
		public double? Latitud { get; set; }
		public double? Longitud { get; set; }

		public bool HarPlats => Latitud is not null && Longitud is not null;
	}
}
